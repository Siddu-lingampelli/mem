# Ensure all text files are committed with LF line endings, regardless of
# the OS that produced the working tree. Without this, Windows + Git's
# default `core.autocrlf=true` converts LF to CRLF on checkout, and
# if a developer commits from Windows with that default the file ends
# up stored as CRLF in the repo. CI on macOS/Ubuntu then sees CRLF and
# may flag it. This forces the stored form to LF.

* text=auto eol=lf

*.json       text eol=lf
*.yml        text eol=lf
*.yaml       text eol=lf
*.md         text eol=lf
*.ts         text eol=lf
*.js         text eol=lf
*.mjs        text eol=lf
*.cjs        text eol=lf
*.css        text eol=lf
*.html       text eol=lf
*.sh         text eol=lf
.gitignore   text eol=lf
.gitattributes text eol=lf

*.png        binary
*.jpg        binary
*.jpeg       binary
*.gif        binary
*.ico        binary
*.svg        binary
*.woff       binary
*.woff2      binary
*.ttf        binary
*.eot        binary

*.bat        text eol=crlf
*.cmd        text eol=crlf
*.ps1        text eol=crlf
